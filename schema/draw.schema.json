{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pandvan/lotto-archive/main/schema/draw.schema.json",
  "title": "Lotto draw",
  "description": "A single Italian Lotto draw: one date, and the five ordered numbers extracted on each wheel that took part.",
  "type": "object",
  "required": ["date", "contest", "wheels"],
  "additionalProperties": false,
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Draw date (Europe/Rome), ISO 8601."
    },
    "contest": {
      "type": "integer",
      "minimum": 1,
      "description": "Official concorso number: the 1-based index of this draw within its calendar year."
    },
    "wheels": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "description": "Only the wheels that actually drew on this date are present. Cagliari and Genova begin on 1939-07-08, Nazionale on 2005-05-04, and several wartime dates are incomplete.",
      "properties": {
        "bari": { "$ref": "#/$defs/numbers" },
        "cagliari": { "$ref": "#/$defs/numbers" },
        "firenze": { "$ref": "#/$defs/numbers" },
        "genova": { "$ref": "#/$defs/numbers" },
        "milano": { "$ref": "#/$defs/numbers" },
        "napoli": { "$ref": "#/$defs/numbers" },
        "palermo": { "$ref": "#/$defs/numbers" },
        "roma": { "$ref": "#/$defs/numbers" },
        "torino": { "$ref": "#/$defs/numbers" },
        "venezia": { "$ref": "#/$defs/numbers" },
        "nazionale": { "$ref": "#/$defs/numbers" }
      }
    }
  },
  "$defs": {
    "numbers": {
      "type": "array",
      "description": "The five extracted numbers, in extraction order (first to fifth).",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 90 }
    }
  }
}
